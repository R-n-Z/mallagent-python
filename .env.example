# ==================== 应用配置 ====================
APP_NAME=SuperBizAgent
DEBUG=True
HOST=0.0.0.0
PORT=9900

# ==================== DashScope 配置 ====================
DASHSCOPE_API_KEY=your-api-key-here
DASHSCOPE_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=qwen-max
DASHSCOPE_EMBEDDING_MODEL=text-embedding-v4
DASHSCOPE_TIMEOUT=180000
DASHSCOPE_MAX_RETRIES=3
DASHSCOPE_RETRY_INITIAL_INTERVAL=2000
DASHSCOPE_RETRY_MULTIPLIER=2
DASHSCOPE_RETRY_MAX_INTERVAL=10000

# ==================== Milvus 配置 ====================
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_USERNAME=
MILVUS_PASSWORD=
MILVUS_DATABASE=default
MILVUS_TIMEOUT=10000

# ==================== RAG 配置 ====================
RAG_TOP_K=3
RAG_MODEL=qwen3-max

# ==================== 文档分块配置 ====================
CHUNK_MAX_SIZE=800
CHUNK_OVERLAP=100

# ==================== MCP 服务配置 ====================
# 支持的 transport 类型：stdio、sse（腾讯云等 /sse/ 端点）、streamable-http（本地 FastMCP）
MCP_ENABLED=false
MCP_CLS_TRANSPORT=streamable-http
MCP_CLS_URL=http://localhost:8003/mcp
MCP_MONITOR_TRANSPORT=streamable-http
MCP_MONITOR_URL=http://localhost:8004/mcp

# ==================== Prometheus 配置 ====================
PROMETHEUS_BASE_URL=http://127.0.0.1:9090
PROMETHEUS_REQUEST_TIMEOUT=10.0
PROMETHEUS_MOCK_ENABLED=false

# ==================== CLS 云日志配置 ====================
CLS_MOCK_ENABLED=true

# ==================== Mall Admin 服务地址 ====================
MALL_ADMIN_BASE_URL=http://localhost:8080

# ==================== 退货审核配置 ====================
RETURN_AUDIT_REJECTION_MAX_CONSECUTIVE=3
RETURN_AUDIT_RECEIPT_UNCONDITIONAL_DAYS=7
RETURN_AUDIT_RECEIPT_CONDITIONAL_DAYS=15

# ==================== 规则 RAG 混合检索配置 ====================
RULE_RAG_ENABLED=true
RULE_RAG_HYBRID_VECTOR_TOP_K=6
RULE_RAG_HYBRID_VECTOR_THRESHOLD=0.26
RULE_RAG_HYBRID_KEYWORD_WEIGHT=0.30
RULE_RAG_HYBRID_VECTOR_WEIGHT=0.65
RULE_RAG_FUZZY_MAX_RELATIVE_DISTANCE=0.35
RULE_RAG_FUZZY_MAX_KEYWORD_LENGTH=10

# ==================== 文件上传配置 ====================
FILE_UPLOAD_PATH=./uploads
FILE_UPLOAD_ALLOWED_EXTENSIONS=txt,md
